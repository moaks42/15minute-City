# Copy to .env and fill in. Never commit .env.
# Prague data platform (free key: https://api.golemio.cz/api-keys). Features that need it disable themselves when empty.
GOLEMIO_API_KEY=
# Optional
AIRLY_API_KEY=

# Engine
DATA_DIR=../data/processed
CORS_ORIGINS=http://localhost:5173

# Web
VITE_API_URL=http://localhost:8000
VITE_USE_FIXTURES=0
VITE_STATIC_FALLBACK=0
